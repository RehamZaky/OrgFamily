rules_version = '2';

// See docs/architecture.md "Firestore sync" and "Family invitations" for
// the design this implements. Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Subcollection rules can't see their parent family doc's
    // resource.data directly, so they fetch it explicitly. The family
    // doc's own rules read resource.data/request.resource.data directly
    // instead (cheaper — no extra read).
    //
    // Membership is proven two ways: the original owner/adult(s) recorded
    // directly on the family doc's `memberUids` (unchanged by invitations
    // — see below for why), or a `joinedUids/{uid}` doc, which is what an
    // invitation grants. `||` short-circuits, so the common single-owner
    // case still costs exactly one extra read, same as before.
    function isFamilyMember(familyId) {
      return isSignedIn() && (
        request.auth.uid in
          get(/databases/$(database)/documents/families/$(familyId)).data.memberUids
        || exists(/databases/$(database)/documents/families/$(familyId)/joinedUids/$(request.auth.uid))
      );
    }

    // Same two-way membership check as isFamilyMember, but for a rule that
    // already has the family doc's own data in hand (resource.data or
    // request.resource.data) and would otherwise pay for a redundant get()
    // of the very document it's evaluating — used only by the family doc's
    // own read/update rules below, which is why it takes memberUids
    // directly instead of looking the doc up itself.
    // The family's Owner specifically — for data only the Owner may touch
    // (Money backups). ownerUid is immutable after creation (see the
    // family doc's update rule), so this can't be claimed by anyone else.
    function isFamilyOwner(familyId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid
          == request.auth.uid;
    }

    // An activity entry's shape (ActivitySyncAdapter.toFirestoreFields plus
    // the engine's updatedAt). type/entityType are open strings in the
    // database, so V3 adds kinds with a rules change only — never a schema
    // change; metadata is bounded in keys, and the whole document by
    // Firestore's own 1 MiB limit.
    function isActivityEnvelope(d) {
      return d.keys().hasOnly(['type', 'actorKind', 'actorUid', 'actorMemberId',
            'actorDeviceId', 'entityType', 'entityId', 'state', 'relatedActivityId',
            'metadata', 'schemaVersion', 'createdAt', 'occurredAt', 'updatedAt'])
        && d.keys().hasAll(['type', 'actorKind', 'entityType', 'entityId', 'metadata',
            'schemaVersion', 'occurredAt'])
        && d.type is string && d.type.size() > 0 && d.type.size() <= 64
        && d.actorKind in ['adult', 'child', 'system']
        && d.entityType is string && d.entityType.size() <= 64
        && d.entityId is string && d.entityId.size() <= 128
        && d.metadata is map && d.metadata.size() <= 20
        && d.schemaVersion is int;
    }

    // The activity types this version records, each with the entity type
    // it must describe (SyncEntityType names). V3's child-device types and
    // actorKind 'child' are added here when child devices can sign in.
    function activityEntityTypes() {
      return {
        'task.created': 'task', 'task.assigned': 'task', 'task.completed': 'task',
        'event.created': 'event', 'event.changed': 'event', 'event.cancelled': 'event',
        'shopping_item.added': 'shoppingItem', 'shopping_item.purchased': 'shoppingItem',
        'shopping_item.removed': 'shoppingItem',
        'member.joined': 'familyMember',
        'responsibility.completed': 'responsibility'
      };
    }

    function activityCollections() {
      return {
        'task': 'tasks', 'event': 'events', 'shoppingItem': 'shoppingItems',
        'familyMember': 'members', 'responsibility': 'responsibilities'
      };
    }

    // A new entry must be a supported type, describe a real entity of the
    // matching kind in this family (the app uploads the change before the
    // entry describing it), and be by an adult account.
    function isSupportedActivity(familyId, d) {
      return d.type in activityEntityTypes()
        && activityEntityTypes()[d.type] == d.entityType
        && d.actorKind in ['adult', 'system']
        && d.actorDeviceId == null
        && exists(/databases/$(database)/documents/families/$(familyId)/$(activityCollections()[d.entityType])/$(d.entityId));
    }

    // actorMemberId may name the writer's own member, or a member with no
    // account (a child, on a shared phone — "on behalf of"); never a member
    // linked to a different account. Null for "not known".
    function isAllowedActingMember(familyId, memberId) {
      return memberId == null || (
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(memberId))
        && get(/databases/$(database)/documents/families/$(familyId)/members/$(memberId))
             .data.get('linkedUid', null) in [null, request.auth.uid]
      );
    }

    function isDirectOrJoinedMember(memberUids, familyId) {
      return isSignedIn() && (
        request.auth.uid in memberUids
        || exists(/databases/$(database)/documents/families/$(familyId)/joinedUids/$(request.auth.uid))
      );
    }

    // Family invitations: a short-lived, single-use code an existing
    // member generates so a second real adult, on their own device with
    // their own Firebase account, can join this family's cloud data — see
    // docs/architecture.md "Family invitations". Top-level (not nested
    // under /families/{familyId}) because a joining device has no local
    // familyId at all yet — it only has the code, which itself carries the
    // familyId as a field once looked up.
    match /invites/{code} {
      // Presenting the exact code is the credential (like a password-reset
      // link) — the joining user isn't a member yet, so this can't require
      // isFamilyMember. Never listable by anyone but the invite's own
      // creator (Settings → "Manage invites" queries
      // `where createdByUid == <own uid>`), so a code can't be discovered
      // by enumeration: an unfiltered or someone-else's-uid query fails
      // this rule as a whole rather than returning a filtered subset.
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.createdByUid == request.auth.uid;

      // expiresAt is bounded server-side, not just trusted from the
      // client's "7 days from now" — otherwise any member could bypass the
      // app and mint a `setDoc` with an arbitrarily far-future expiresAt,
      // and the claim rule below (which only checks
      // `request.time < resource.data.expiresAt`) would treat it as valid
      // for however long it said. The cap is the app's own 7-day validity
      // (FamilyInviteRepository._validity) plus one hour: expiresAt is
      // computed from the *device* clock, so without that slack a phone
      // running a few minutes fast would have every invite rejected. The
      // two must change together — see docs/architecture.md "Family
      // invitations".
      //
      // inviterName is optional display text for the joiner's "Join
      // <name>'s family?" confirmation (the joiner can't read the family
      // doc or its members until after joining) — bounded so it can't be
      // used to stash arbitrary data on a world-readable-by-code doc, and
      // keys().hasOnly stops any other field riding along for the same
      // reason.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(
             ['familyId', 'createdByUid', 'expiresAt', 'usedByUid', 'usedAt', 'inviterName'])
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.usedByUid == null
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(169, 'h')
        && (!('inviterName' in request.resource.data)
            || (request.resource.data.inviterName is string
                && request.resource.data.inviterName.size() <= 80))
        && isFamilyMember(request.resource.data.familyId);

      // Single-use: only an unclaimed invite (resource.data.usedByUid ==
      // null) can be claimed, and only by stamping *this* uid as the
      // claimant — the very act of claiming makes every later claim
      // attempt (by anyone, including a retry by the same uid) fail this
      // same check, since resource.data.usedByUid is no longer null.
      // A claim may touch usedByUid/usedAt and nothing else, so it can't
      // also rewrite who created it, which family it's for, when it
      // expires, or the inviter name the next joiner would be shown.
      allow update: if isSignedIn()
        && resource.data.usedByUid == null
        && request.resource.data.usedByUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedByUid', 'usedAt'])
        && request.time < resource.data.expiresAt;

      // Lets the inviter revoke an unused code early.
      allow delete: if isSignedIn() && resource.data.createdByUid == request.auth.uid;
    }

    // Per-account record of which family the account belongs to, kept by
    // SyncEngine while it syncs — how a member signing in on a new device
    // finds their family again without another invite (membership belongs
    // to the account, not to a device). See docs/architecture.md "Family
    // invitations" § "New devices".
    //
    // Only ever readable/writable by its own account, and a write must
    // name a family the account really is a member of right now, so it
    // can't be used to point an account at someone else's family (and a
    // revoked member can't refresh it). It only *names* the family — it
    // grants nothing: reading the family still goes through the
    // membership rules below.
    match /users/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['familyId', 'updatedAt'])
        && request.resource.data.familyId is string
        && isFamilyMember(request.resource.data.familyId);
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /families/{familyId} {
      allow read: if isDirectOrJoinedMember(resource.data.memberUids, familyId);

      // Only the linking Owner may create the family doc, and only with
      // themselves as the sole initial member — real second-adult
      // onboarding goes through the invites/joinedUids flow below instead
      // of ever mutating memberUids.
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids.size() == 1
        && request.resource.data.memberUids[0] == request.auth.uid;

      // ownerUid/memberUids are authorization metadata, immutable after
      // creation by anyone, including the owner — any other field a
      // member adds later (there are none yet) may change freely. A
      // joined-via-invite adult's access is proven by their own
      // joinedUids doc below, never by appending to this array, so this
      // stays untouched by invitations.
      allow update: if isDirectOrJoinedMember(resource.data.memberUids, familyId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.memberUids == resource.data.memberUids;

      allow delete: if false;

      // Grants a joined-via-invite adult standing access to this family's
      // cloud data. Doc id is the uid itself, so isFamilyMember's check
      // above is a plain exists(), no query. Deliberately a second write,
      // not atomic with claiming the invite above (a client does both
      // sequentially, not in one transaction) — see docs/architecture.md
      // "Family invitations" for why a claimed-but-ungranted invite is an
      // acceptable degraded case (a wasted code, recoverable by generating
      // a new one) rather than a security gap.
      match /joinedUids/{uid} {
        allow read: if isFamilyMember(familyId);
        allow create: if isSignedIn()
          && request.auth.uid == uid
          && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.usedByUid == request.auth.uid
          && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.familyId == familyId;
        allow update, delete: if false;
      }

      match /members/{memberId} {
        allow read, write: if isFamilyMember(familyId);
      }

      match /tasks/{taskId} {
        allow read, write: if isFamilyMember(familyId);
      }

      match /events/{eventId} {
        allow read, write: if isFamilyMember(familyId);
      }

      match /shoppingLists/{listId} {
        allow read, write: if isFamilyMember(familyId);
      }

      match /shoppingItems/{itemId} {
        allow read, write: if isFamilyMember(familyId);
      }

      // Per-member recurring chores — same member-only access as tasks.
      // Who may create/delete/tick which chore (a Child only their own) is
      // enforced in the app, like task permissions: children have no
      // accounts of their own yet, so the rules can't tell them apart.
      match /responsibilities/{responsibilityId} {
        allow read, write: if isFamilyMember(familyId);
      }

      // Family activity log (V2.1, see family_activities_table.dart). Any
      // member reads; an entry is written once and never rewritten or
      // deleted — a history, not shared state. actorUid must be the writer
      // (or null for an entry made while signed out); actorMemberId must be
      // the writer's own member or an account-less one (children have no
      // accounts yet, so that part is "on behalf of"). The entry must
      // describe an existing entity of its type. occurredAt must be the
      // server's time, so a wrong device clock can't reorder the timeline.
      //
      // Deliberately not checked: that the entity's current state matches
      // (e.g. the task is completed). Any member may already write that
      // state directly, so it would prove nothing more, and an offline
      // complete-then-undo would upload the undone task first and get the
      // genuine entry rejected for good.
      //
      // The only change allowed afterwards is the sync engine re-sending
      // the same entry unchanged — nothing but updatedAt may differ, so an
      // entry can't be edited or moved in the timeline. (A retry whose
      // first attempt already landed reads the stored entry back instead
      // of re-sending: see SyncEngine._pushOne.)
      match /activities/{activityId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && isActivityEnvelope(request.resource.data)
          && isSupportedActivity(familyId, request.resource.data)
          && (request.resource.data.actorUid == null
              || request.resource.data.actorUid == request.auth.uid)
          && isAllowedActingMember(familyId, request.resource.data.actorMemberId)
          && request.resource.data.occurredAt == request.time;
        allow update: if isFamilyMember(familyId)
          && isActivityEnvelope(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['updatedAt']);
        allow delete: if false;
      }

      // Money backups (docs/roadmap.md "Money backup") — Owner only, read
      // and write, including the encryption key. Adults and children never
      // see the family's financial backups or the key that opens them.
      match /moneyBackupKey/{doc} {
        allow read, write: if isFamilyOwner(familyId);
      }
      match /moneyBackups/{backupId} {
        allow read, write: if isFamilyOwner(familyId);

        match /chunks/{chunkId} {
          allow read, write: if isFamilyOwner(familyId);
        }
      }
    }
  }
}
